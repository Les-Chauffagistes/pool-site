generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model rewards {
  id          Int    @id @default(autoincrement())
  year        Int
  month       Int
  reward_name String

  @@unique([year, month, reward_name], map: "rewards_year_month_reward_name_key")
}
